<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>snippets.export.confirm.message %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Fragment zapisany do pliku: %lld.</string>
            <key>few</key>
            <string>Fragmenty zapisane do pliku: %lld.</string>
            <key>many</key>
            <string>Fragmentów zapisanych do pliku: %lld.</string>
        </dict>
    </dict>
    <key>logins.export.summary %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Zestaw logowania zapisany do pliku: %lld.</string>
            <key>few</key>
            <string>Zestawy logowania zapisane do pliku: %lld.</string>
            <key>many</key>
            <string>Zestawów logowania zapisanych do pliku: %lld.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.activeTransfers %1$lld %2$lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@tabs@</string>
        <key>tabs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%1$lld karta zostanie zamknięta, co anuluje aktywny transfer w %2$lld z nich.</string>
            <key>few</key>
            <string>%1$lld karty zostaną zamknięte, co anuluje aktywne transfery w %2$lld z nich.</string>
            <key>many</key>
            <string>%1$lld kart zostanie zamkniętych, co anuluje aktywne transfery w %2$lld z nich.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.incomingTransfers %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld karta odbiera transfer z innej karty; jej zamknięcie anuluje ten transfer.</string>
            <key>few</key>
            <string>%lld karty odbierają transfery z innych kart; ich zamknięcie anuluje te transfery.</string>
            <key>many</key>
            <string>%lld kart odbiera transfery z innych kart; ich zamknięcie anuluje te transfery.</string>
        </dict>
    </dict>
</dict>
</plist>
