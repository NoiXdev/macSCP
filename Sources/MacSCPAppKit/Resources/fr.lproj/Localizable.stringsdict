<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>snippets.export.confirm.message %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld snippet sera écrit dans le fichier.</string>
            <key>other</key>
            <string>%lld snippets seront écrits dans le fichier.</string>
        </dict>
    </dict>
    <key>logins.export.summary %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld jeu d’identifiants sera écrit dans le fichier.</string>
            <key>other</key>
            <string>%lld jeux d’identifiants seront écrits dans le fichier.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.activeTransfers %1$lld %2$lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@tabs@</string>
        <key>tabs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>La fermeture de %1$lld onglet annule le transfert actif dans %2$lld d’entre eux.</string>
            <key>other</key>
            <string>La fermeture de %1$lld onglets annule les transferts actifs dans %2$lld d’entre eux.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.incomingTransfers %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld d’entre eux reçoit un transfert d’un autre onglet ; la fermeture annule ce transfert.</string>
            <key>other</key>
            <string>%lld d’entre eux reçoivent des transferts d’autres onglets ; la fermeture annule ces transferts.</string>
        </dict>
    </dict>
    <key>settings.connection.keepAliveInterval %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Toutes les %lld seconde</string>
            <key>other</key>
            <string>Toutes les %lld secondes</string>
        </dict>
    </dict>
    <key>settings.connection.keepAlive.footer %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Activée, macSCP vérifie une connexion inactive toutes les %lld seconde. Désactivée, l'intervalle choisi est conservé pour quand vous réactiverez la vérification.</string>
            <key>other</key>
            <string>Activée, macSCP vérifie une connexion inactive toutes les %lld secondes. Désactivée, l'intervalle choisi est conservé pour quand vous réactiverez la vérification.</string>
        </dict>
    </dict>
    <key>tunnel.dock.running %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld redirection active</string>
            <key>other</key>
            <string>%lld redirections actives</string>
        </dict>
    </dict>
    <key>tunnel.state.activeWithFailures %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Active · %lld connexion échouée</string>
            <key>other</key>
            <string>Active · %lld connexions échouées</string>
        </dict>
    </dict>
    <key>tunnel.state.degraded %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Dégradée · %lld connexion échouée d’affilée</string>
            <key>other</key>
            <string>Dégradée · %lld connexions échouées d’affilée</string>
        </dict>
    </dict>
    <key>connection.convertKey.repoint.message %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@sessions@</string>
        <key>sessions</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Ce jeu d’identifiants est utilisé par une session, directement ou pour son hôte relais. Sa clé pointera vers la clé convertie « %2$@ ».</string>
            <key>other</key>
            <string>Ce jeu d’identifiants est utilisé par %1$lld sessions, directement ou pour leur hôte relais. Sa clé pointera vers la clé convertie « %2$@ » pour toutes.</string>
        </dict>
    </dict>
    <key>browser.transferConfirm.upload.message %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%1$lld élément sera envoyé vers « %2$@ ».</string>
            <key>other</key>
            <string>%1$lld éléments seront envoyés vers « %2$@ ».</string>
        </dict>
    </dict>
    <key>browser.transferConfirm.upload.messageWithFolders %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%1$lld dossier sera envoyé vers « %2$@ » avec tout son contenu.</string>
            <key>other</key>
            <string>%1$lld éléments, dont des dossiers avec tout leur contenu, seront envoyés vers « %2$@ ».</string>
        </dict>
    </dict>
    <key>browser.transferConfirm.download.message %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%1$lld élément sera téléchargé dans « %2$@ ».</string>
            <key>other</key>
            <string>%1$lld éléments seront téléchargés dans « %2$@ ».</string>
        </dict>
    </dict>
    <key>browser.transferConfirm.download.messageWithFolders %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%1$lld dossier sera téléchargé dans « %2$@ » avec tout son contenu.</string>
            <key>other</key>
            <string>%1$lld éléments, dont des dossiers avec tout leur contenu, seront téléchargés dans « %2$@ ».</string>
        </dict>
    </dict>
</dict>
</plist>
