<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>snippets.export.confirm.message %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld snippet will be written to the file.</string>
            <key>other</key>
            <string>%lld snippets will be written to the file.</string>
        </dict>
    </dict>
    <key>logins.export.summary %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld login will be written to the file.</string>
            <key>other</key>
            <string>%lld logins will be written to the file.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.activeTransfers %1$lld %2$lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@tabs@</string>
        <key>tabs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Closing %1$lld tab cancels the active transfer in %2$lld of it.</string>
            <key>other</key>
            <string>Closing %1$lld tabs cancels active transfers in %2$lld of them.</string>
        </dict>
    </dict>
    <key>tabs.closeOthers.incomingTransfers %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld of them is receiving a transfer from another tab; closing cancels that.</string>
            <key>other</key>
            <string>%lld of them are receiving transfers from other tabs; closing cancels those.</string>
        </dict>
    </dict>
    <key>settings.connection.keepAliveInterval %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Every %lld second</string>
            <key>other</key>
            <string>Every %lld seconds</string>
        </dict>
    </dict>
    <key>settings.connection.keepAlive.footer %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>While on, macSCP checks an idle connection every %lld second. Off keeps the interval for when you turn it back on.</string>
            <key>other</key>
            <string>While on, macSCP checks an idle connection every %lld seconds. Off keeps the interval for when you turn it back on.</string>
        </dict>
    </dict>
</dict>
</plist>
