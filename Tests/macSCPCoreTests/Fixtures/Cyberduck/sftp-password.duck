<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Protocol</key>
	<string>sftp</string>
	<key>Hostname</key>
	<string>sftp-password.example.net</string>
	<key>Port</key>
	<string>2222</string>
	<key>UUID</key>
	<string>22222222-2222-2222-2222-222222222222</string>
	<key>Provider</key>
	<string>sftp</string>
	<key>Username</key>
	<string>webadmin</string>
	<key>Nickname</key>
	<string>Password Box</string>
</dict>
</plist>
