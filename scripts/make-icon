#!/bin/bash
# Renders the app-icon SVG into Resources/AppIcon.icns.
# The .icns is COMMITTED so packaging never needs librsvg; rerun this
# script only when the icon SVG changes.
#
# INTERIM (maintainer decision, 2026-07-27): the icon currently uses the
# shared interim artwork in icon-interim.svg. The designed CI icon
# (variant A, docs/design/assets/icon.svg, see docs/design/ci.md) stays
# the documented master — switch SVG back to it to restore.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v rsvg-convert >/dev/null 2>&1 || {
    echo "error: rsvg-convert not found — install it with: brew install librsvg" >&2
    exit 1
}

SVG="docs/design/assets/icon-interim.svg"
ICONSET="$(mktemp -d)/AppIcon.iconset"
ICNS="Resources/AppIcon.icns"
mkdir -p "$ICONSET" Resources

for size in 16 32 128 256 512; do
    rsvg-convert -w "$size" -h "$size" "$SVG" -o "$ICONSET/icon_${size}x${size}.png"
    rsvg-convert -w "$((size * 2))" -h "$((size * 2))" "$SVG" -o "$ICONSET/icon_${size}x${size}@2x.png"
done

iconutil -c icns "$ICONSET" -o "$ICNS"
rm -rf "$(dirname "$ICONSET")"
echo "wrote $ICNS"
