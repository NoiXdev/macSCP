#!/bin/bash
# Capture evidence from the intermittent 0%-CPU test-suite hang.
#
# THE POINT OF THIS SCRIPT is the `sample` call, not the loop. The hang leaves
# a process alive at 0% CPU forever with NOTHING on any thread stack — a
# suspended Swift task lives on the heap, not on a thread — so the only way to
# learn anything is to catch a hung process while it is still running. Killing
# it first destroys the evidence.
#
# Usage:
#   scripts/hang-hunt                     # 40 sequential full-suite runs
#   RUNS=60 FILTER=ImportConflictBridge scripts/hang-hunt
#   WORKERS=4 scripts/hang-hunt           # concurrent workers = machine load
#
# Env:
#   RUNS      iterations per worker          (default 40)
#   WORKERS   concurrent workers             (default 1)
#   FILTER    --filter argument, empty = all (default empty)
#   TIMEOUT   seconds before a run counts as hung (default 240)
#   OUT       evidence directory             (default .hang-evidence, git-ignored)
#
# A run that tested NOTHING is refused, not counted (2026-10-05). After run 1
# the worker checks for `warning: No matching test cases were run` AND for a
# `Test run with N tests` line, and on either failure it stops, keeps that
# run's log and returns non-zero. `--filter` matches TYPE and FUNCTION names,
# never a suite's DISPLAY name, so `FILTER='A probe that never began'` matches
# nothing where `FILTER=ProbeStartTests` matches a suite; before this gate the
# first spelling printed "N runs, no hang" and exited 0. The companion rule is
# scripts/mutation-probe's NO TESTS RAN outcome. The zero-test run is told apart
# from a real one by two facts measured on 2026-10-05: it prints that warning,
# and it prints NO `Test run with N tests` line at all (a matching run prints
# one), so the second check does work the first cannot.
#
# Exit status — 0 no hang, 1 refused or prebuild failed, 2 hang captured:
#   0  every run finished inside TIMEOUT ("N runs, no hang")
#   1  a worker refused (nothing ran) or its prebuild failed
#   2  a hang was CAPTURED — finding one is this script's PURPOSE, not a
#      failure of it, so 2 is success; the evidence is in $OUT as HANG-*
# A refusal and a prebuild failure win over a captured hang in another worker,
# so 1 always means "this loop did not test what you asked".
#
# EXIT 2 MEANS A CAPTURE WAS ATTEMPTED AND THE STATUS SET — NOT that what landed
# in $OUT is usable. Measured 2026-10-05 with `TIMEOUT=1 FILTER=ProbeStartTests
# RUNS=1`: the script exited 2, and `HANG-w1-1-context.txt` came out 136 bytes and
# 4 lines — an EMPTY `### ps` section and an empty test log, the run's own log 0
# bytes — with NO `HANG-*-sample-*.txt` written at all, because at one second
# nothing matched the `pgrep` and `swift test` had printed nothing yet. The
# `ps`/`sample` half is what the paragraph at the top of this file calls "THE POINT
# OF THIS SCRIPT", and no run on the branch that added these codes exercised it:
# only the 240 s default against a real hang can. So read 2 as "a capture ran",
# then read $OUT before believing it.
#
# Before 2026-10-05 the status told none of these apart. What was swallowed was
# a failed PREBUILD: a bare `wait` returns 0 whatever its jobs returned, so the
# worker's 1 was lost and the script exited 0 — measured 2026-10-05 by running
# `git show 14ca8f35^:scripts/hang-hunt` from a directory holding no
# Package.swift, which printed "w1: prebuild FAILED", then "done" and "no hang
# captured", and exited 0. A refused run was NOT swallowed then: refusal did not
# exist before the gate above, added the same day. What 2026-10-05 added here is
# the third code — until it, "hang captured" and "no hang" both exited 0.
#
# $OUT ACCUMULATES ACROSS INVOCATIONS, so the HANG-* listing the tail prints is
# not necessarily THIS run's. Measured 2026-10-05: `FILTER=ProbeStartTests
# RUNS=1` printed "w1: 1 runs, no hang" and then `HANG-w1-1-context.txt`, left
# by a `TIMEOUT=1` capture one invocation earlier. `ls "$OUT" | grep HANG` was
# the only documented discriminator and it is not run-scoped; the exit code is,
# which is the measured reason it was needed.
#
# STILL NOT SEEN BY THIS SCRIPT (undecided, recorded in docs/BACKLOG.md):
# `wait "$pid" 2>/dev/null` discards `swift test`'s own exit status and the
# `rm -f "$log"` below then deletes that run's log, so a loop of FAILING runs
# reports "N runs, no hang" with nothing left to read. Measured 2026-10-05:
# `FILTER=ViewTestabilitySpike RUNS=1` printed "w1: run 1 ran 7 test(s) —
# looping." and "w1: 1 runs, no hang" and exited 0, over a run that `swift test`
# ended with status 1 and the line "✘ Test run with 7 tests in 1 suite failed".
# The gate reads its count out of that very line, so it counts a FAILED run as
# evidence that the loop tested something.
#
# Each worker uses its OWN scratch path so the loop never contends with a
# normal `swift test` in this checkout for the .build lock — lock contention is
# a DIFFERENT failure that already cost this project a day (M20/T12: a gated
# test invoked `swift build` from inside `swift test` and deadlocked).
#
# ALSO WORTH KNOWING, learned the hard way: when a hung `swift test` is killed,
# its `swiftpm-testing-helper` child SURVIVES, reparented to launchd, and runs
# forever. Two such orphans were found alive after 46 hours. This script kills
# the whole family; if you kill a run by hand, check afterwards with
#   pgrep -fl swiftpm-testing-helper

set -u
REPO=$(cd "$(dirname "$0")/.." && pwd)
OUT=${OUT:-$REPO/.hang-evidence}
RUNS=${RUNS:-40}
WORKERS=${WORKERS:-1}
FILTER=${FILTER:-}
TIMEOUT=${TIMEOUT:-240}

mkdir -p "$OUT"
cd "$REPO" || exit 1

worker() {
    local id=$1
    local scratch="$OUT/build-w$id"
    local args=(--scratch-path "$scratch")
    [ -n "$FILTER" ] && args+=(--filter "$FILTER")

    swift build --build-tests --scratch-path "$scratch" >"$OUT/prebuild-w$id.log" 2>&1 || {
        echo "w$id: prebuild FAILED, see $OUT/prebuild-w$id.log"; return 1; }

    for i in $(seq 1 "$RUNS"); do
        local log="$OUT/w$id-run-$i.log"
        swift test "${args[@]}" >"$log" 2>&1 &
        local pid=$!
        local waited=0
        while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$TIMEOUT" ]; do
            sleep 1; waited=$((waited + 1))
        done

        if kill -0 "$pid" 2>/dev/null; then
            echo "*** w$id run $i HUNG after ${waited}s — capturing ***"
            {
                echo "### ps"
                ps -Ao pid,ppid,%cpu,state,etime,command \
                    | grep -E "swiftpm-testing-helper|macSCPPackageTests" | grep -v grep
                echo
                echo "### test log (its LAST LINE names the test that was in flight —"
                echo "### the stack cannot tell you, so this is the decisive datum)"
                cat "$log"
            } >"$OUT/HANG-w$id-$i-context.txt" 2>&1

            for p in $(pgrep -f "swiftpm-testing-helper|macSCPPackageTests" 2>/dev/null); do
                sample "$p" 3 -mayDie -f "$OUT/HANG-w$id-$i-sample-$p.txt" >/dev/null 2>&1
            done

            pkill -9 -f "$scratch" 2>/dev/null
            kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
            echo "w$id: evidence in $OUT/HANG-w$id-$i-*"
            # 2, not 0: a captured hang is this script's purpose and must be
            # told apart from "no hang" by the status, because the $OUT listing
            # below cannot tell them apart (see the header).
            return 2
        fi

        wait "$pid" 2>/dev/null

        # A run that tested NOTHING is its own outcome, distinct from green
        # and from hung — the same distinction scripts/mutation-probe draws
        # with its NO TESTS RAN line, and for the same reason: a harness that
        # only watches for failure reads "nothing ran" as "nothing wrong".
        # `--filter` matches TYPE and FUNCTION names, never a suite's DISPLAY
        # name, so a filter spelling the display name matches nothing and
        # SwiftPM exits 0. docs/BACKLOG.md records a 40-run loop lost to it.
        # Checked on the FIRST run only: a filter cannot start matching
        # halfway through a loop.
        if [ "$i" -eq 1 ]; then
            if grep -q 'No matching test cases were run' "$log"; then
                echo "w$id: REFUSED after run 1 — that run tested NOTHING."
                echo "w$id: 'swift test' printed 'No matching test cases were run' and exited 0."
                echo "w$id: FILTER='$FILTER' matched no type or function name."
                echo "w$id: --filter matches TYPE and FUNCTION names, never a suite's display name."
                echo "w$id: log kept at $log"
                return 1
            fi
            # The positive beside that negative, because a negative check that
            # greps one known string goes quiet the day SwiftPM rewords it:
            # the run must also SAY how many tests it ran.
            local ran
            ran=$(grep -oE 'Test run with [0-9]+ test' "$log" | head -1 | grep -oE '[0-9]+')
            if [ -z "$ran" ] || [ "$ran" -eq 0 ]; then
                echo "w$id: REFUSED after run 1 — no evidence that any test ran."
                echo "w$id: its output carries no 'Test run with N tests' line."
                echo "w$id: FILTER='$FILTER'"
                echo "w$id: log kept at $log"
                return 1
            fi
            echo "w$id: run 1 ran $ran test(s) — looping."
        fi

        rm -f "$log"
    done
    echo "w$id: $RUNS runs, no hang"
}

# A bare `wait` returns 0 whatever its jobs returned, so every worker's pid is
# waited on by itself and its code is remembered. 1 (refused or prebuild failed)
# wins over 2 (hang captured): a loop that did not test what you asked is the
# more important thing to learn, and anything a worker returns that is neither
# 0 nor 2 is treated as 1. The exit is the LAST statement: the `ls | grep ||
# echo` below succeeds unconditionally and would otherwise overwrite it.
pids=()
for w in $(seq 1 "$WORKERS"); do worker "$w" & pids+=($!); done
status=0
for p in ${pids[@]+"${pids[@]}"}; do
    wait "$p"
    rc=$?
    if [ "$rc" -eq 2 ]; then
        [ "$status" -eq 0 ] && status=2
    elif [ "$rc" -ne 0 ]; then
        status=1
    fi
done
# The verdict goes FIRST, above `done` and the HANG listing. Until 2026-10-05 it
# came last, so a refusal printed "done" and "no hang captured" ABOVE the line
# correcting them — a reader skimming the tail met the clean negative first.
if [ "$status" -eq 1 ]; then
    echo "at least one worker REFUSED or failed its prebuild — see the w<N>: lines above"
elif [ "$status" -eq 2 ]; then
    echo "a hang was CAPTURED — that is what this script is for; evidence in $OUT"
fi
echo "done"
# Not run-scoped: $OUT keeps every earlier invocation's HANG-* files, so read
# the exit status, not this listing.
ls "$OUT" | grep HANG || echo "no hang captured"
exit "$status"
