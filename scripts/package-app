#!/bin/bash
# Assembles dist/macSCP.app from a fresh release build. Localization
# NOTE (M5i lesson): macOS picks the app language from the MAIN bundle's
# localizations — the empty en.lproj/de.lproj markers are what make the
# German catalogs inside the SPM resource bundles reachable at all.
set -euo pipefail
cd "$(dirname "$0")/.."

# MACSCP_VERSION overrides (the release workflow derives it from the tag).
VERSION="${MACSCP_VERSION:-1.0.0}"
BUILD="${MACSCP_BUILD:-1}"

# Universal binary (M6b final-review fix: an arm64-only build shipped in
# v1.0.0 while the README promises plain "macOS 15+"). Built as two
# single-arch slices + lipo instead of `--arch arm64 --arch x86_64`:
# the dual-arch path routes through XCBuild, which insists on compiling
# SwiftTerm's bundled Shaders.metal and therefore needs the ~700 MB
# Metal toolchain component (absent on CI runners and flaky locally).
# The native single-arch pipeline ships the shader as a plain resource —
# no Metal toolchain needed anywhere.
swift build -c release --triple arm64-apple-macosx
swift build -c release --triple x86_64-apple-macosx
ARM_BIN="$(swift build -c release --triple arm64-apple-macosx --show-bin-path)"
X86_BIN="$(swift build -c release --triple x86_64-apple-macosx --show-bin-path)"

APP="dist/macSCP.app"
rm -rf dist
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

lipo -create "$ARM_BIN/macSCP" "$X86_BIN/macSCP" \
    -output "$APP/Contents/MacOS/macSCP"
# The command-line companion ships INSIDE the bundle, next to the app
# binary. Two reasons it lives here rather than beside the .app in the DMG:
# `codesign` seals everything under Contents/ into the app's own signature,
# so the CLI is covered by the release signature and by the app's
# notarization ticket with no extra submission; and installing the app to
# /Applications gives the CLI one stable, documentable path
# (/Applications/macSCP.app/Contents/MacOS/macscp-cli) instead of a copy
# the user has to place somewhere by hand. That stable signature is what
# makes a keychain "Always Allow" decision stick across invocations.
lipo -create "$ARM_BIN/macscp-cli" "$X86_BIN/macscp-cli" \
    -output "$APP/Contents/MacOS/macscp-cli"
cp Resources/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
# Resource bundles are architecture-independent — take the arm64 build's.
cp -R "$ARM_BIN/macSCP_MacSCPAppKit.bundle" "$APP/Contents/Resources/"
cp -R "$ARM_BIN/macSCP_macSCPCore.bundle" "$APP/Contents/Resources/"
mkdir "$APP/Contents/Resources/en.lproj" "$APP/Contents/Resources/de.lproj" \
      "$APP/Contents/Resources/fr.lproj" "$APP/Contents/Resources/pl.lproj"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
        <string>fr</string>
        <string>pl</string>
    </array>
    <key>CFBundleDisplayName</key><string>macSCP</string>
    <key>CFBundleExecutable</key><string>macSCP</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIdentifier</key><string>dev.noix.macscp</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>macSCP</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>${VERSION}</string>
    <key>CFBundleVersion</key><string>${BUILD}</string>
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 noix</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>dev.noix.macscp.sessions</string>
            <key>UTTypeDescription</key><string>macSCP Sessions</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>macscpsessions</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>dev.noix.macscp.logins</string>
            <key>UTTypeDescription</key><string>macSCP Logins</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>macscplogins</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>dev.noix.macscp.snippets</string>
            <key>UTTypeDescription</key><string>macSCP Snippets</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>macscpsnippets</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
PLIST

plutil -lint "$APP/Contents/Info.plist"
test -x "$APP/Contents/MacOS/macSCP"
test -x "$APP/Contents/MacOS/macscp-cli"
# Both architectures must be present (Intel Macs run macOS 15 too).
for BIN in macSCP macscp-cli; do
    lipo -archs "$APP/Contents/MacOS/$BIN" | grep -q x86_64
    lipo -archs "$APP/Contents/MacOS/$BIN" | grep -q arm64
done
test -d "$APP/Contents/Resources/macSCP_MacSCPAppKit.bundle"
test -d "$APP/Contents/Resources/macSCP_macSCPCore.bundle"
test -d "$APP/Contents/Resources/en.lproj" -a -d "$APP/Contents/Resources/de.lproj" \
     -a -d "$APP/Contents/Resources/fr.lproj" -a -d "$APP/Contents/Resources/pl.lproj"
echo "wrote $APP (v${VERSION}, build ${BUILD})"
